# Copy to .env (repo root or the folder you run from) and fill in. Never commit .env.
# Shell variables and --model / --api-base / --api-key flags override these.

# Which LLM to use (LiteLLM model string). Unset = dictionary ranking only.
EVAL_METRICS_MODEL=ollama/qwen3:4b

# Where the model is served. Unset = the provider's default
# (Ollama: http://localhost:11434). Examples:
#   EVAL_METRICS_API_BASE=http://192.168.1.50:11434     # Ollama on another machine
#   EVAL_METRICS_API_BASE=http://localhost:1234/v1      # LM Studio (model: openai/<name>)
# EVAL_METRICS_API_BASE=

# Hosted providers only: the key LiteLLM reads for your model's provider.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
